# ============================================================================
# Copy this file to .env before running `docker compose up --build`.
# `.env` is gitignored — never commit real secrets.
#
#   cp .env.example .env
#
# ============================================================================

# --- Database ---
POSTGRES_USER=jobportal
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=jobportal
POSTGRES_PORT=5432

# --- Backend ---
# Generate a strong key with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000
NODE_ENV=production
LOG_LEVEL=info

# --- Frontend ---
FRONTEND_PORT=3000
# Baked into the static bundle at build time by Vite.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- Seed users (used once on first boot; ignored if users already exist) ---
SEED_HR_EMAIL=admin@test.com
SEED_HR_PASSWORD=Admin@1234
SEED_HR_NAME=HR Admin
SEED_CANDIDATE_EMAIL=user@test.com
SEED_CANDIDATE_PASSWORD=User@1234
SEED_CANDIDATE_NAME=Test Candidate