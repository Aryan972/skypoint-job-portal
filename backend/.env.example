# ============================================================================
# Local-only backend env (for running outside Docker, e.g. `npm run dev`).
# When running via `docker compose up`, the root .env is used instead and these
# values are supplied by docker-compose.yml.
# ============================================================================

DATABASE_URL=postgresql://jobportal:change_me_in_production@localhost:5432/jobportal?schema=public
JWT_SECRET=replace-this-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12
PORT=8000
NODE_ENV=development
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

SEED_HR_EMAIL=admin@test.com
SEED_HR_PASSWORD=Admin@1234
SEED_HR_NAME=HR Admin
SEED_CANDIDATE_EMAIL=user@test.com
SEED_CANDIDATE_PASSWORD=User@1234
SEED_CANDIDATE_NAME=Test Candidate